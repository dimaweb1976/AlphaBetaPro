<Window x:Class="AlphaBetaPro.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AlphaBetaPro — AMBER diagnostic"
        Width="1120" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#FFE9EEF5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="12" BorderBrush="#FFD0D7E2" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock Text="AMBER" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0" />
                <TextBlock Text="Адрес" VerticalAlignment="Center" />
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                <TextBlock Text="Порт" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="85" />
                <Button Content="Подключить" Command="{Binding ConnectCommand}" />
                <Button Content="Отключить" Command="{Binding DisconnectCommand}" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#FF304A6E" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Каналы" FontSize="17" FontWeight="SemiBold" Margin="4,2,4,10" />
                    <ListBox ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="9" Margin="2" Background="{StaticResource PanelBrush}" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RunState}" Foreground="#FF52647C" />
                                        <TextBlock Text="{Binding TotalCounts, StringFormat=Импульсы: {0}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="5" Padding="16">
                <Grid DataContext="{Binding SelectedChannel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" />
                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,14,0,14">
                        <StackPanel Margin="4"><TextBlock Text="Состояние" Foreground="#FF68768A"/><TextBlock Text="{Binding RunState}" FontSize="17"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="Серийный номер" Foreground="#FF68768A"/><TextBlock Text="{Binding SerialNumber}" FontSize="17"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="Каналы" Foreground="#FF68768A"/><TextBlock Text="{Binding ChannelCount}" FontSize="17"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="Total counts" Foreground="#FF68768A"/><TextBlock Text="{Binding TotalCounts}" FontSize="17"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="Real time" Foreground="#FF68768A"/><TextBlock Text="{Binding RealTime}" FontSize="17"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="Live time" Foreground="#FF68768A"/><TextBlock Text="{Binding LiveTime}" FontSize="17"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="Dead time" Foreground="#FF68768A"/><TextBlock Text="{Binding DeadTime}" FontSize="17"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="Count rate" Foreground="#FF68768A"/><TextBlock Text="{Binding CountRate, StringFormat={}{0} cps}" FontSize="17"/></StackPanel>
                    </UniformGrid>
                    <GroupBox Grid.Row="2" Header="Первые 32 канала — диагностический просмотр">
                        <TextBox Text="{Binding SpectrumPreview, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 AcceptsReturn="True" Background="#FFFAFBFD" />
                    </GroupBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="12,0,12,12" Background="White" CornerRadius="5" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Журнал" FontWeight="SemiBold" Margin="3,0,3,6" />
                <ListBox ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="12" />
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Background="White" Padding="10" BorderBrush="#FFD0D7E2" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <Button Content="CLEAR" Command="{Binding ClearCommand}" />
                <Button Content="START" Command="{Binding StartCommand}" Background="#FFDDF4DF" />
                <Button Content="STOP" Command="{Binding StopCommand}" Background="#FFFFE2E2" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
